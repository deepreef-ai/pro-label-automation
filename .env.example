# Copy to .env (git-ignored) and fill in locally. NEVER commit real keys (the repo is public).

# ---- AI: mode, order, speed ----
# cloud = API providers with fallback; local = Ollama only
AI_MODE=cloud
# Provider order (comma list). Default: anthropic,groq,cerebras,gemini,sambanova,mistral,nvidia,github,openrouter,huggingface,ollama
# Claude is paid (~$4 / $20 per million input / output tokens): put free ones first to save money.
LLM_ORDER=
# Providers raced at once (first good answer wins); 1 = sequential
LLM_PARALLEL=2
# Seconds a throttled/broken key is parked before it is used again
LLM_COOLDOWN_SECONDS=60

# ---- AI: provider keys and models ----
# Every key is optional (no key = provider skipped). Extra keys per provider:
# add <KEY>_2 ... <KEY>_9 (e.g. GEMINI_API_KEY_2, GROQ_API_KEY_2); calls rotate across them.
# Empty model = built-in default (see apps/api/core/llm/README.md).
# Claude (Anthropic, paid, most capable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# low (default, fastest/cheapest) | medium | high
ANTHROPIC_EFFORT=
ANTHROPIC_TIMEOUT=
# Groq
GROQ_API_KEY=
GROQ_MODEL=
# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
# SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=
# NVIDIA (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=
# GitHub Models (a GitHub token with models:read)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=
# OpenRouter (use :free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Hugging Face
HF_TOKEN=
HF_MODEL=
# Local model via Ollama's OpenAI-compatible endpoint (no key)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ---- AI: cache and timeouts ----
# Cache of LLM answers for repeatable demos (git-ignored); 1 = record live answers
LLM_CACHE_PATH=data/llm_cache.json
LLM_CACHE_RECORD=
# Seconds per cloud call / per Ollama call
LLM_TIMEOUT=20
LLM_LOCAL_TIMEOUT=90

# ---- Backend ----
# Local SQLite file under data/ (git-ignored); Postgres URL works too
DATABASE_URL=sqlite:///data/demo.db

# ---- Frontend (Vite) ----
# mock = use contract/fixtures; live = call the API below
VITE_API_MODE=mock
VITE_API_URL=http://localhost:8000
