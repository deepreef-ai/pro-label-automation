# Copy to .env (git-ignored) and fill in locally. NEVER commit real keys.

# ---- AI ----
# cloud = free API tiers with fallback; local = Ollama only; off = no LLM calls
AI_MODE=cloud
# Google AI Studio key (free tier) and optional model override
GEMINI_API_KEY=
GEMINI_MODEL=
# Fallback providers (free tiers)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Local model via Ollama's OpenAI-compatible endpoint
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ---- Backend ----
# Local SQLite file under data/ (git-ignored); Postgres URL works too
DATABASE_URL=sqlite:///data/demo.db
# Cache of LLM responses for repeatable demos (git-ignored)
LLM_CACHE_PATH=data/llm_cache.json

# ---- Frontend (Vite) ----
# mock = use contract/fixtures; live = call the API below
VITE_API_MODE=mock
VITE_API_URL=http://localhost:8000
